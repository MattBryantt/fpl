# Copy to .env and fill in. Never put a real key in this file -- .env.example is
# the committed template, .env is the gitignored one that holds your secrets.
#
# Free key from https://the-odds-api.com/ (500 requests/month on the free tier).
# Optional: without it the model falls back to xG-derived team ratings.
ODDS_API_KEY=

# Bookmaker regions to pull, comma separated: uk, eu, us, au
ODDS_REGIONS=uk

# Understat season to use for the underlying per-player rates.
# Use the season START year, e.g. 2025 means the 2025/26 season.
UNDERSTAT_SEASON=2025

# --- Asking questions about a player ------------------------------------------
# Optional. Powers the "Ask about this player" box in the drafting board, which
# answers from the numbers the projection actually produced -- it is handed the
# player's full points breakdown and told to work from that alone.
#
# Any OpenAI-compatible /chat/completions endpoint works. Three free ways:
#
#  1. Ollama, on your own machine. No key, no account, no quota, and nothing
#     leaves the laptop. This is the default, so if you have it there is nothing
#     to set here.
#       brew install ollama && ollama pull llama3.1:8b
#
#  2. Google AI Studio (Gemini). Free tier, no card, generous limits.
#       FPL_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#       FPL_AI_MODEL=gemini-2.0-flash
#       FPL_AI_KEY=...            from https://aistudio.google.com/apikey
#
#  3. Groq. Free tier, very fast.
#       FPL_AI_BASE_URL=https://api.groq.com/openai/v1
#       FPL_AI_MODEL=llama-3.3-70b-versatile
#       FPL_AI_KEY=...            from https://console.groq.com/keys
#
# Options 2 and 3 send the player's numbers to that provider. They are public
# football statistics, but it is still an external service, so it is off unless
# you configure it. The key stays in the server process and is never sent to the
# browser.
FPL_AI_BASE_URL=
FPL_AI_MODEL=
FPL_AI_KEY=
