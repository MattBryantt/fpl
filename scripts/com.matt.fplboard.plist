<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the drafting board running so a phone can reach it over Tailscale.
     Installed to ~/Library/LaunchAgents by scripts/setup-phone-access.sh.

     A LaunchAgent, not a LaunchDaemon: the board runs out of a virtualenv in
     this user's home directory and reads this user's .env, so it belongs to the
     login session. The practical cost is that it starts at login rather than at
     boot. If the Mac restarts, log in once and it comes back by itself. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.matt.fplboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/scripts/board-agent.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart it whatever happens: an unhandled exception on some future
       gameweek boundary should cost one request, not a day of not noticing. -->
  <key>KeepAlive</key>
  <true/>

  <!-- If it is crash-looping, back off rather than respin sixty times a minute
       and bury the reason at the top of a log nobody is watching. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__ROOT__/out/board.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/out/board.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
